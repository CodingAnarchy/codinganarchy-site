---
import type { CollectionEntry } from 'astro:content';
import { getLatestVersion } from '../lib/versions';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, tagline, language, status } = project.data;
const version = await getLatestVersion(project.data.package);
---

<a class="card" href={`/projects/${project.id}/`}>
  <h3>{name}</h3>
  <p>{tagline}</p>
  <div class="meta">
    <span>{language}</span>
    {version && <span class="version">v{version}</span>}
    <span class:list={['status', status]}>{status}</span>
  </div>
</a>
